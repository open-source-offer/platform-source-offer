<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sign_oca_request_form_training" model="ir.ui.view">
        <field name="name">sign.oca.request.form.training</field>
        <field name="model">sign.oca.request</field>
        <field name="inherit_id" ref="sign_oca.sign_oca_request_form_view"/>
        <field name="arch" type="xml">
            <!-- Le document réglementaire est affiché en lecture seule et à
                 côté du rattachement générique : il dit de quelle pièce
                 scellée provient le PDF mis à la signature, ce que
                 `record_ref` ne dit pas (il pointe le dossier, pas la pièce). -->
            <xpath expr="//field[@name='record_ref']" position="after">
                <field name="training_document_id" readonly="1"
                       invisible="not training_document_id"/>
            </xpath>
            <!-- L'exemplaire émis ne se remplace pas, même en brouillon (la
                 garde serveur est dans `_training_check_write_allowed`). -->
            <xpath expr="//field[@name='data']" position="attributes">
                <attribute name="readonly">state != '1_draft' or training_document_id</attribute>
            </xpath>
        </field>
    </record>
</odoo>
