# Reverse proxy TLS (certificats Let's Encrypt automatiques). Variables d'environnement : voir docker-compose.yml.
{
	email {$ACME_EMAIL}
	# HTTP/1.1 et HTTP/2 seulement : aucun port UDP 443 à ouvrir.
	servers {
		protocols h1 h2
	}
}

# Politique d'intégration (iframe) : le serveur, avec l'option « embedding » activée (décret ENABLE_EMBEDDING),
# émet frame-ancestors 'self' https: vector: (n'importe quel site https). On la RESTREINT ici aux seules origines
# voulues : le domaine principal (le bac à sable est intégré par le domaine principal) et les origines Odoo.
# Le motif couvre toute directive frame-ancestors émise par l'amont, quelle que soit sa forme.
# Réglage de politique d'en-tête de sécurité ; aucune réécriture du contenu servi.
(embedding_policy) {
	header_down Content-Security-Policy "frame-ancestors [^;]*" "frame-ancestors 'self' {$COLLAB_ORIGIN} {$FRAME_ANCESTORS}"
}

# En-têtes de sécurité communs. « ? » = posé seulement si l'amont ne l'a pas déjà fait (pas d'écrasement de
# la politique de l'application). CSP de repli : réponses sans CSP (fichiers statiques, erreurs) non intégrables ailleurs.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "no-referrer"
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		?Content-Security-Policy "frame-ancestors 'self' {$COLLAB_ORIGIN} {$FRAME_ANCESTORS}"
		# Pas d'en-têtes révélant les logiciels (identité neutre, moindre information).
		-Server
		-Via
		-X-Powered-By
	}
}

# Navigation directe interdite (P-2) : l'éditeur n'est destiné qu'à être intégré (iframe) par Odoo. Une visite
# directe d'un navigateur (Sec-Fetch-Dest: document) créerait des documents persistants hors Odoo : réponse 403
# neutre (sans marque). Les chargements en iframe, scripts, styles, images et websocket ne sont pas concernés.
# Exception : la page de licence AGPL (§13), qui doit rester publique. Limite connue : un navigateur ancien
# n'envoyant pas Sec-Fetch-* (ou un client non navigateur) n'est pas filtré ici ; l'éviction intégrée de
# CryptPad (config.js : inactiveTime) supprime alors les documents inactifs. Choix « fail open » assumé, car
# bloquer sans Sec-Fetch-Dest casserait aussi les iframes d'intégration de ces navigateurs.
(block_direct_navigation) {
	# /install (création du premier compte administrateur par jeton journalisé au démarrage) et /admin :
	# aucun usage prévu (adminKeys vide, administration par config.js/décrets) -> refusés SANS condition,
	# y compris pour les clients qui n'envoient pas Sec-Fetch-Dest.
	@admin_paths path /install /install/* /admin /admin/*
	handle @admin_paths {
		header Cache-Control "no-store"
		header Content-Type "text/html; charset=utf-8"
		respond "<!doctype html><meta charset=utf-8><title>Accès refusé</title><p>Accès refusé.</p>" 403
	}
	@direct_nav {
		header Sec-Fetch-Dest document
		not path /customize/licence.html
	}
	handle @direct_nav {
		header Cache-Control "no-store"
		header Content-Type "text/html; charset=utf-8"
		respond "<!doctype html><meta charset=utf-8><title>Accès refusé</title><p>Accès refusé.</p>" 403
	}
}

# Domaine principal : interface, API et websocket.
{$COLLAB_DOMAIN} {
	encode zstd gzip
	import security_headers
	import block_direct_navigation
	handle {
		reverse_proxy cryptpad:3000 {
			import embedding_policy
		}
	}
}

# Domaine du bac à sable (httpSafeOrigin) : même processus, port 3001.
{$COLLAB_SANDBOX_DOMAIN} {
	encode zstd gzip
	import security_headers
	import block_direct_navigation
	handle {
		reverse_proxy cryptpad:3001 {
			import embedding_policy
		}
	}
}
