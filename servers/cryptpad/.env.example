# Copier en .env (non versionné, droits 600). Aucun secret requis par ce kit ; ACME_EMAIL sert aux avis Let's Encrypt.
COMPOSE_PROJECT_NAME=collab

# Deux noms de domaine distincts, DNS A vers l'IP de la VM (à poser par l'exploitant).
COLLAB_DOMAIN=collab.amwalo.com
COLLAB_SANDBOX_DOMAIN=collab-sandbox.amwalo.com
COLLAB_ORIGIN=https://collab.amwalo.com
COLLAB_SANDBOX_ORIGIN=https://collab-sandbox.amwalo.com

# Origines Odoo autorisées à intégrer l'éditeur (CSP frame-ancestors), séparées par des espaces.
FRAME_ANCESTORS=https://www.amwalo.com https://www.alkhobarae.network https://staging.amwalo.com

ACME_EMAIL=exploitation@example.invalid

# Répertoire des données persistantes (sauvegardé par scripts/backup.sh).
DATA_DIR=/srv/collab/data

# Ports publiés (80/443 en production ; valeurs non standard réservées aux essais locaux).
HTTP_PORT=80
HTTPS_PORT=443
